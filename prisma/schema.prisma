// Gigwright database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL is intentionally not declared here. Prisma 7 dropped the
  // `url = env(...)` form in favor of declaring connection details
  // exclusively in prisma.config.ts (so the same config drives both
  // CLI tooling and the runtime Client). See prisma.config.ts.
}

// ═══════════════════════════════════════════════════════════════
// Auth.js models (magic-link email flow)
// ═══════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN     // Patrick — sees all tenants, manages subscriptions, overrides limits
  OWNER     // Paying bandleader — runs the app for their gigs
  MUSICIAN  // Sideman — sees only gigs they're assigned to, read-only, no finances
}

enum Plan {
  FREE
  PRO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role UserRole @default(OWNER)
  plan Plan     @default(FREE)

  // Stripe wiring (populated once subscriptions are live)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime?

  // Set when Stripe reports a renewal payment failed (invoice.payment_failed
  // webhook). Cleared on the next successful invoice. The billing page reads
  // this to render a "Your last payment failed — update your card" nudge.
  paymentFailedAt DateTime?
  // Set when Stripe sends the trial_will_end event (~3 days before charge).
  // Cleared once a successful invoice lands. Surfaces a "trial ends soon"
  // banner with a link to add/confirm a payment method.
  trialEndingAt   DateTime?
  // Mirrors Stripe's cancel_at_period_end flag on the active subscription.
  // When true, the user has cancelled but their Pro access remains until
  // currentPeriodEnd. UI shows "Cancelled — Pro until [date]" so they
  // aren't confused that the cancel didn't take effect.
  cancelAtPeriodEnd Boolean @default(false)

  // Custom sender for outbound fanout emails. When set, fanout sends as
  // "{User.name}" <{senderEmail}> (and the user's domain must be verified
  // at Resend). When null, fanout falls back to "{User.name} via GigWright"
  // <{EMAIL_FROM}>.
  senderEmail String?

  // Payment methods this bandleader actually offers to their band. When
  // empty (default), the app treats it as "all supported methods except
  // Zelle" — that matches the global rollout where Zelle was disabled
  // network-wide. Bandleaders can opt Zelle back in (and remove others
  // they don't actually use) on the Settings page; every payment-method
  // dropdown in the app filters to this list so musicians can't pick a
  // method their leader doesn't pay with.
  enabledPaymentMethods String[] @default([])

  // Calendar subscription token. Random unguessable string the user
  // pastes into Apple/Google/Outlook to subscribe to their gigs as a
  // live .ics feed. Generated on first request and cached; null until
  // then. Tokenized (not email-keyed) so anyone with the URL gets the
  // feed without an additional sign-in step — the calendar app itself
  // has no way to authenticate.
  icalToken String? @unique

  // Referral program (Patrick 2026-08-06): refer 3 paying users and
  // your own subscription becomes $0 via a 100%-off recurring Stripe
  // coupon. Applied lazily — recalc runs on every subscription-state
  // webhook event that touches a referred user.
  //
  //  - referralCode: your unguessable 8-char code, embedded in the
  //    URL you share (gigwright.com/?ref=CODE). Generated lazily on
  //    first access from /settings/billing so existing users get one
  //    the moment they open the referral card.
  //  - referredById: the User.id of the person whose ?ref= cookie was
  //    set when you signed up. Immutable after signup so the credit
  //    can't be moved after the fact.
  //  - referralCompActive: mirror of whether the 100%-off coupon is
  //    currently applied to your Stripe subscription. Kept locally so
  //    the recalc doesn't hit Stripe for every no-op check.
  referralCode       String? @unique
  referredById       String?
  referredBy         User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]  @relation("UserReferrals")
  referralCompActive Boolean @default(false)

  accounts  Account[]
  sessions  Session[]
  venues    Venue[]
  musicians Musician[]                          // as owner (bandleader's roster)
  playsAs   Musician[]  @relation("MusicianUser") // as musician (where they play)
  gigs      Gig[]
  producers Producer[]                          // people who book this bandleader
  qbo       QboConnection?

  @@index([referredById])
}

// QuickBooks Online OAuth tokens + company pointer. Access tokens expire in
// ~1 hour; refresh tokens in 100 days (Intuit auto-rotates refresh tokens on
// each use — we persist the new one each time we refresh).
model QboConnection {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  realmId      String  // QBO company ID
  accessToken  String  @db.Text
  refreshToken String  @db.Text
  expiresAt    DateTime

  // Which QBO account do band-pay bills post into? Defaults to the first
  // account whose name contains "Contract" on connect; user can override in
  // the Settings → Integrations page.
  defaultExpenseAccountId   String?
  defaultExpenseAccountName String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Every /signin submission that would fire a magic-link Resend send
// gets logged here first, then rate-limited. Without this table, the
// sign-in form is an open Resend spigot — an attacker (or dumb bot)
// can post any email address to /api/auth/... and burn through the
// account's daily/monthly quota. Rows are consulted by
// auth.ts:sendVerificationRequest; anything older than the rate-limit
// window can be pruned.
model MagicLinkAttempt {
  id        String   @id @default(cuid())
  // Lower-cased. Matches sendVerificationRequest's normalization so
  // per-email limits can't be bypassed with mixed-case dupes.
  email     String
  // "sent" = we passed the email to Resend. "blocked" = we short-
  // circuited (rate limit hit, honeypot triggered, etc). Both count
  // toward the per-email limit so a bot mashing the form can't rack
  // up unlimited 'blocked' rows to hide real sends.
  outcome   String
  // Optional low-cardinality context so we can look at the log later:
  // "signin" (form-driven), "invite" (bandleader clicked Send Login
  // Invite from a musician's edit page), etc.
  source    String   @default("signin")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// Gigwright domain
// ═══════════════════════════════════════════════════════════════

enum CalendarProvider {
  ICLOUD
  GOOGLE
  OUTLOOK
  NONE
}

enum PaymentMethod {
  VENMO
  PAYPAL
  ZELLE
  CASHAPP
  CASH
  CHECK
  DIRECT_DEPOSIT
  OTHER
}

enum GigStatus {
  INQUIRY
  HOLD
  CONFIRMED
  PLAYED
  CANCELLED
}

model Venue {
  id         String  @id @default(cuid())
  name       String
  addressL1  String?
  addressL2  String?
  city       String?
  state      String?
  postalCode String?
  country    String  @default("US")
  phone      String?
  contactName  String?
  contactEmail String?
  notes      String?
  timezone   String  @default("America/New_York")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  gigs Gig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Producer — a person who books this bandleader. Populated from client
// contacts extracted from uploaded contracts, or manually. Same shape
// as a lightweight CRM contact. Distinct from Venue.contactName because
// the same producer books events at many different venues (booking
// agent, wedding planner, corporate event coordinator).
model Producer {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  company String?
  notes   String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  gigs Gig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  // Case-insensitive email uniqueness is enforced in application code
  // (Prisma doesn't do citext); dedup logic in venue-producer-match.ts.
  @@index([ownerId, email])
}

model Musician {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  initials  String? // e.g. "DR" — overrideable, otherwise derived from name
  avatarUrl String? // Vercel Blob URL — headshot shown on roster and gig personnel rows

  // Linked User (nullable) — populated once the musician logs in via a matching
  // email. One User can be linked to multiple Musician rows across tenants.
  userId     String?
  user       User?   @relation("MusicianUser", fields: [userId], references: [id])
  invitedAt  DateTime? // when the admin sent them the login invite email

  // Roles, freeform — e.g. ["Drums"], ["Sax", "Arranger"]
  roles String[]

  isLeader Boolean @default(false)

  // "My Crew" flag — this musician is in the bandleader's default
  // lineup and pre-fills any new gig's personnel section when the
  // bandleader clicks "Load My Crew." Managed exclusively through the
  // gig form ("Save this lineup as My Crew" button); intentionally no
  // roster-page toggle, per Patrick's design 2026-08-06.
  isCrew   Boolean @default(false)

  calendarProvider CalendarProvider @default(NONE)
  paymentMethod    PaymentMethod?

  // The destination to send money: Zelle email/phone, Venmo @handle,
  // PayPal email, Cashtag (with or without $), etc. Interpreted based on
  // paymentMethod.
  payoutAddress    String?

  // SMS notification opt-in. Defaults to FALSE per TCR/CTIA rule:
  // consent to receive SMS may not be a required condition of service.
  // Bandleader-added musicians must explicitly opt themselves in (via
  // /my-profile or the bandleader's invite flow) before any SMS fans
  // out to them. Email defaults to true — operational gig-coordination
  // email is the baseline transport and does not require SMS consent.
  notifyBySms   Boolean @default(false)
  notifyByEmail Boolean @default(true)

  // W-9 tracking — every outbound message auto-includes either a request
  // (if not received) or a "W-9 received" confirmation (if received).
  w9Received    Boolean   @default(false)
  w9ReceivedAt  DateTime?
  w9RequestedAt DateTime? // when we last sent the W-9 request email — so UI can show "requested [date]"

  notes String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  gigPersonnel GigPersonnel[]
  // Per-gig mileage records the musician logs for their own 1099 / Schedule C
  // tracking. Separate from GigExpense (which is the bandleader's expense
  // bucket) so a musician's personal mileage never pollutes their leader's
  // gig P&L. One row per (musicianId, gigId) — see MusicianGigMileage.
  mileage   MusicianGigMileage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Queued guest-approval notification. When the bandleader toggles a
// guest's approval state, instead of firing the email/SMS immediately
// we upsert a row here with scheduledFor = now + 2 min. The cron-style
// processor picks up due rows, compares pendingState to initialState,
// fires the notification only if the net state actually changed, and
// deletes the row. Rapid tick/untick within the 2-minute window
// collapses to a single notification reflecting the FINAL state — no
// barrage of texts if the bandleader corrects an error.
model PendingGuestNotification {
  id           String   @id @default(cuid())
  personnelId  String
  personnel    GigPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  guestName    String
  // The approval state BEFORE the first toggle in this batch. Used at
  // send time to short-circuit "tick then untick back to the original
  // state" — if pending matches initial, no notification fires.
  initialState Boolean
  // The approval state after the most recent toggle in this batch.
  pendingState Boolean
  scheduledFor DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([personnelId, guestName])
  @@index([scheduledFor])
}

// Per-musician, per-gig mileage. Lives separate from GigExpense (which is
// bandleader-scoped) so a sideman's commute to the venue is their own tax
// record, not their leader's gig P&L. Round-trip miles only — most working
// musicians drive home after the gig so the round-trip number is what
// matches their odometer logbook and what flows straight into the IRS
// standard mileage deduction at year end.
model MusicianGigMileage {
  id         String   @id @default(cuid())
  musicianId String
  musician   Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  gigId      String
  gig        Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  miles Int     // round-trip miles for this gig
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([musicianId, gigId])
  @@index([musicianId])
  @@index([gigId])
}

model Gig {
  id String @id @default(cuid())

  // Core date/time fields
  // startAt is the authoritative "when is this gig" field (downbeat time).
  // The detail screen also tracks optional load-in, soundcheck, and end times.
  startAt         DateTime // Downbeat (first show)
  loadInAt        DateTime?
  soundcheckAt    DateTime?
  soundcheckEndAt DateTime? // when the band is freed up after sound check
  callTimeAt      DateTime?
  endAt           DateTime? // null = "open"  (first show finish)
  // Optional second-show times for jazz clubs running two sets in one
  // night (e.g. Funky Biscuit 6 PM + 9 PM). Both null = single show.
  secondStartAt   DateTime?
  secondEndAt     DateTime?

  status GigStatus @default(CONFIRMED)

  // Money — all values stored in cents.
  clientPayCents     Int? // What the client pays leader
  clientDepositCents Int? // Deposit collected so far

  // Tech & logistics (mirrors the mockup)
  sound             String? // e.g. "House FOH"
  soundContactName  String? // e.g. "Joe the house engineer"
  soundContactPhone String? // e.g. "(561) 555-1234"
  lights            String? // e.g. "House"
  attire            String? // e.g. "Black on black"
  meal              String? // e.g. "After check · green room"

  // Optional event/performance name. Used when the venue name alone
  // doesn't say what's actually happening — e.g. "Patrick Lamb Quartet",
  // "Smith Wedding", "NYE Show", "Saxophone Sundays". Renders subtly
  // under the venue name on the gig page, on the dashboard list, in
  // emails, and on the public gig sheet. Null when not set; never
  // overrides the venue name, just adorns it.
  eventName String?

  // Clickable link to the folder/drive with all charts, arrangements, audio
  materialsUrl String?

  // Uploaded set list (Vercel Blob URL) + original filename + when last changed,
  // so we can fire an SMS/email fanout on swap.
  setlistUrl       String?
  setlistFileName  String?
  setlistUpdatedAt DateTime?

  // Specific loading info for this gig — text notes ("enter through alley 2,
  // knock on service door"), an optional uploaded map image, and an optional
  // alternate map link (e.g. a Google Maps pin). All three optional.
  loadingInfo    String?
  loadingMapUrl  String? // Vercel Blob URL for the uploaded map image
  loadingMapLink String? // external map link, e.g. https://maps.app.goo.gl/…

  // Stage plot — PDF or image (PNG/JPG) showing the stage layout, mic
  // positions, monitor mix, etc. Same upload pattern as loadingMapUrl:
  // Vercel Blob URL + original filename. Email/portal renders it as a
  // clickable "Stage plot ↗" link (not embedded inline).
  stagePlotUrl      String?
  stagePlotFileName String?

  // Rooming / lodging info — where the band is staying and who's rooming
  // with whom. The bandleader picks ONE of two forms per gig: typed notes
  // (roomingInfo — "Hampton Inn, 2 queens, Patrick+Joe / Tony solo") OR an
  // uploaded rooming-list document (roomingUrl + roomingFileName — a PDF the
  // tour manager sent, or a photo of a printed sheet). Both fields are
  // optional and independent, but the UI toggles between the two so only one
  // is typically set. Rendered on the musician portal, public sheet, print
  // sheet, and email fanout the same way stage plot / loading info are.
  roomingInfo     String?
  roomingUrl      String? // Vercel Blob URL for the uploaded rooming list
  roomingFileName String? // original filename of the uploaded rooming list

  notes String?

  // Private finance notes — bandleader-only scratchpad on the Payout
  // Worksheet. NEVER included in the email fanout, the public gig sheet,
  // or the musician portal. Use for deal-memo reminders, deposit math,
  // tax-time annotations, "client wants invoice by Friday" — anything the
  // band shouldn't see.
  privateFinanceNotes String?

  // Client contract for this gig — PDF uploaded by the bandleader. Same
  // pattern as setlistUrl / stagePlotUrl (Vercel Blob URL + original
  // filename) but explicitly private: NEVER rendered on the public gig
  // sheet, the print sheet, the musician portal, or the email fanout.
  // Bandleader-only so Patrick doesn't have to search through email
  // threads / DocuSign / Dropbox for a signed venue contract on gig night.
  contractUrl      String?
  contractFileName String?

  // Last "Send update" the bandleader fired for this gig — captures the
  // headline (lastUpdateLabel) and free-form message (lastUpdateMessage)
  // that were sent in the email/SMS fanout, plus when. Rendered at the
  // TOP of every sheet surface (public /g/[id], musician portal, print
  // sheet) so a musician who clicks the SMS link sees the actual
  // change-note, not just the static gig info. Cleared on next update
  // and overwritten — only the most recent matters at gig time.
  lastUpdateLabel   String?
  lastUpdateMessage String?
  lastUpdateAt      DateTime?

  // Per-musician guest-list cap for this gig. Null = no cap (musicians
  // can add as many names as they want). Set when the venue restricts
  // ("two per band member"). The musician's row shows "N / cap used"
  // and the "+ Add another" link disables at the cap. The bandleader
  // sees the cap on their gig page; it's purely advisory on the
  // bandleader's own list since they're the one approving.
  guestListCap Int?

  // QuickBooks sync state. qboSyncedAt is set every time we push this gig's
  // bills to QBO; if updatedAt > qboSyncedAt, the UI shows "Changes unsynced
  // — Re-push" state. qboSyncError caches the last push error for display.
  qboSyncedAt DateTime?
  qboSyncError String?

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Producer / booker — the client-side person who booked this gig.
  // Extracted from an uploaded contract, or attached manually. Same
  // producer can be linked to many gigs (e.g., a wedding planner who
  // books the band six times a year).
  producerId String?
  producer   Producer? @relation(fields: [producerId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  personnel        GigPersonnel[]
  expenses         GigExpense[]
  activity         Activity[]
  // Per-musician mileage records for sidemen who track their own 1099
  // mileage on this gig (see MusicianGigMileage).
  musicianMileage  MusicianGigMileage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, startAt])
}

// Freeform line items for a gig — flights, hotels, ad spend, transportation,
// food, anything that isn't musician pay. Modeled after the Iridium Payout
// worksheet pattern: add rows as needed, everything rolls up into the net.
model GigExpense {
  id     String @id @default(cuid())
  gigId  String
  gig    Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  label       String
  amountCents Int
  category    String? // optional grouping (travel, promo, meals, etc.)
  position    Int @default(0)

  // Tax-aware kind for year-end reporting. Defaults to GENERAL so existing
  // rows are unaffected. MILEAGE rows carry `miles`; PER_DIEM rows carry
  // `days`. Both are optional inputs that help compute amountCents, but the
  // amount itself stays the source of truth once saved.
  kind   ExpenseKind @default(GENERAL)
  miles  Int?        // miles driven (when kind = MILEAGE)
  days   Int?        // days (when kind = PER_DIEM)

  paidAt DateTime? // when the expense was paid / cleared

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gigId])
}

// Tax-aware expense categories. GENERAL is the default freeform bucket;
// MILEAGE / MEAL / PER_DIEM roll up separately for year-end 1099/Schedule C.
enum ExpenseKind {
  GENERAL
  MILEAGE
  MEAL      // Meals & entertainment (50% deductible on Schedule C)
  PER_DIEM  // Federal per-diem
  LODGING
  TRAVEL    // Flights, ground transit, parking — 100% business
}

model GigPersonnel {
  id String @id @default(cuid())

  gigId      String
  gig        Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  musicianId String
  musician   Musician @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  roleLabel String? // Override of musician.roles for this specific gig, optional
  payCents  Int     @default(0)
  position  Int     @default(0)

  paidAt         DateTime?
  paidMethod     PaymentMethod?

  calendarSynced Boolean   @default(false)
  calendarSyncedAt DateTime?

  // Whether this personnel row appears in the Lineup section of the
  // band-facing email fanout. Defaults to true. The bandleader can
  // uncheck it for crew/contractors (sound, lights, booking agent)
  // whose contact info shouldn't be circulated to the rest of the
  // band. The person themselves still receives their own copy of the
  // email if their notify flags are on — they're just hidden from
  // *other* recipients' Lineup section.
  includeInLineup Boolean @default(true)

  // Per-row QBO pointers so we can update/void the exact bill if the pay
  // amount changes post-push.
  qboVendorId String?
  qboBillId   String?

  // Guest list this musician is requesting for this gig — freeform
  // multi-line text, one name per line ("Sarah Smith +1", "Tom Jones").
  // Filled in by the musician from their /my-gigs/[id] page; aggregated
  // and shown to the bandleader on the gig detail page so they can
  // hand a single consolidated list to the venue.
  guestList          String?
  guestListUpdatedAt DateTime?
  pendingGuestNotifications PendingGuestNotification[]

  // Bandleader-approved subset of the names above. Each entry is the
  // exact line string the musician typed (e.g. "Sarah Smith +1"), so
  // approvals survive when the musician edits unrelated lines but are
  // intentionally dropped when they re-type or rearrange a specific
  // name. Empty array = nothing approved yet (default state for any
  // new guest). The bandleader toggles approvals one at a time from
  // the gig detail page; the venue copy of the list is what's
  // approved, not what's submitted.
  approvedGuests     String[] @default([])

  // Accept/Decline invitation flow — patterned after IML/Emerald
  // Empire Band. Bandleader clicks "Invite" on the Payout Worksheet
  // row; sendGigInvite() generates inviteToken, emails the musician
  // with big Accept/Decline buttons pointing at
  // /g/[gigId]/rsvp/[token]?answer=yes|no (public, no login). The
  // musician clicks either button; response + respondedAt land on
  // this row. Bandleader gets a notification either way.
  //
  // response is "accepted" or "declined" (plain string, not enum, so
  // future values like "maybe" or "pending" don't need a migration).
  // inviteToken is per-row so revoking one musician's link doesn't
  // affect others.
  invitedAt      DateTime?
  respondedAt    DateTime?
  response       String?
  inviteToken    String?   @unique

  // Email delivery tracking (Patrick 2026-08-08). resendEmailId is
  // the id Resend returns from POST /emails; we store it on send so
  // later webhook events (email.opened, email.clicked, email.bounced)
  // can be correlated back to this personnel row. emailOpenedAt is
  // the FIRST time the tracking pixel loaded — subsequent opens don't
  // move it. emailClickedAt is the first click on any link. Both null
  // until Resend fires the event; null does NOT mean "didn't open" —
  // could also mean "blocks tracking pixels" (Gmail image proxy still
  // resolves though, so most desktop opens land).
  resendEmailId  String?   @unique
  emailOpenedAt  DateTime?
  emailClickedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, musicianId])
  @@index([gigId])
  @@index([musicianId])
}

// Timeline of changes on a gig — the foundation for "diff-aware notifications"
// and the activity feed shown in the mockup's gig detail page.
model Activity {
  id String @id @default(cuid())

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  // Structured action + human-readable summary
  action  String // e.g. "gig_alert_sent", "time_updated", "personnel_added"
  summary String // e.g. "Gig alert sent to 3", "Time updated · diff text sent"

  // Optional machine-readable diff payload
  payload Json?

  createdAt DateTime @default(now())

  @@index([gigId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// SMS opt-in (public web form)
// ═══════════════════════════════════════════════════════════════

// Record of an end-user explicitly opting in to receive SMS via the
// public form at /sms-opt-in. This exists primarily as the TCR-verifiable
// Call to Action for our A2P 10DLC campaign: regulators (and any TCR
// reviewer) can navigate to the form, submit it, see a confirmation, and
// verify a row landed here. Our day-to-day flow is the offline
// contractor-onboarding conversation between bandleader and musician,
// but TCR requires a public web mechanism they can test directly. Both
// paths coexist; this is the testable surface.
model SmsOptIn {
  id String @id @default(cuid())

  // Phone number stored in E.164 (+15035551234) format. The form
  // normalizes whatever the user types.
  phone String

  // Optional metadata to help the bandleader match this opt-in to a
  // real musician on their roster.
  name       String?
  bandleader String? // free-text "who hired you" so we can route correctly

  // EXACT consent language shown to the user at the moment they
  // submitted, captured verbatim. This is the audit trail TCR and
  // carriers ask for if they ever review a specific opt-in.
  consentText String

  // Audit metadata — IP + user-agent at submit time. Required by some
  // carriers if there's ever a dispute over whether consent was given.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}
